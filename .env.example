# Copy this file to .env.local and fill in machine-specific values.
# .env.local is loaded by Poe tasks and should not be committed.

# Kimodo inference server bind address.
# Houdini client tools use the same host/port when no explicit
# KIMODO_REMOTE_MOTION_SERVER_URL has been saved or exported.
# Use 0.0.0.0 only as a server bind address; clients on other machines should
# connect to the server machine's LAN IP.
# KIMODO_SERVER_HOST=127.0.0.1
# KIMODO_SERVER_PORT=8000
# KIMODO_REMOTE_MOTION_SERVER_URL=http://127.0.0.1:8000

# Text encoder strategy.
# external: use TEXT_ENCODER_URL to connect to an already-running service.
# local: load LLM2Vec in the current process; model/cache variables matter.
# managed: start a local service subprocess; GRADIO_* and TMP settings matter.
# auto: try TEXT_ENCODER_URL first, then fall back to local loading.
# TEXT_ENCODER_MODE=local

# External/auto service URL. In pure local mode this is ignored.
# TEXT_ENCODER_URL=http://127.0.0.1:9550/

# Local LLM2Vec loading. These matter for local, managed, and auto fallback.
# In pure external mode, set them on the process that actually runs the
# text encoder service, not necessarily on the client/server process.
# HF_HOME=
# LLM2VEC_BASE_MODEL_PATH=
# TEXT_ENCODERS_DIR=

# Local loading options. TEXT_ENCODER_DEVICE mainly affects local/managed
# loading; TEXT_ENCODER_FP32 mainly affects managed or direct text-encoder runs.
# TEXT_ENCODER_DEVICE=cuda:0
# TEXT_ENCODER_FP32=0

# Managed text encoder subprocess settings.
# GRADIO_SERVER_NAME=0.0.0.0
# GRADIO_SERVER_PORT=9550
# TEXT_ENCODER_TMP_FOLDER=.cache/text_encoder

# Configuration of real runtime tests.
# KIMODO_REAL_MODEL=kimodo-soma-rp
# KIMODO_REAL_DEVICE=cpu
